{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "watchPatterns": ["backend/**", "infra/railway/cron-sync-tcgcsv.railway.json"]
  },
  "deploy": {
    "startCommand": "python manage.py sync_tcgcsv",
    "cronSchedule": "0 3 * * *",
    "restartPolicyType": "NEVER"
  }
}
