# Millennium — Hetzner self-host env template.
# Copy to infra/hetzner/.env on the box, fill the secrets, and lock it down:
#   cp .env.example .env && chmod 600 .env
# .env is gitignored — NEVER commit real secrets. prod.py reads no dotenv
# (Invariant 3); docker compose loads this file for the containers' env.

# === Django (config.settings.prod) ===
DJANGO_SETTINGS_MODULE=config.settings.prod
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CHANGE_ME_strong_random_50+_chars
# Django sees Host: backend (Next's changeOrigin rewrite forwards the
# destination host); the public host is included as belt-and-suspenders.
DJANGO_ALLOWED_HOSTS=backend,localhost,127.0.0.1,millennium.erickti.com
# The browser's Origin — the public frontend (scheme included). Invariant 10.
DJANGO_CSRF_TRUSTED_ORIGINS=https://millennium.erickti.com
# TLS terminates at Caddy; the backend receives internal plain HTTP, so it must
# NOT 301 http->https (that would loop the proxy). Same posture as a private-
# only backend. Cookies are still Secure (pinned in prod.py) and the browser
# leg (browser<->Caddy) is HTTPS.
DJANGO_SECURE_SSL_REDIRECT=False

# === Database (Postgres container) ===
# Use a URL-SAFE password (hex avoids '/@?' that would break DATABASE_URL
# parsing): openssl rand -hex 32  — then put the SAME value in both lines.
POSTGRES_USER=millennium
POSTGRES_DB=millennium
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_32
DATABASE_URL=postgres://millennium:CHANGE_ME_openssl_rand_hex_32@postgres:5432/millennium

# === Celery — configured but NEVER dialed under the cron topology ===
# No worker/beat runs; the scheduled commands call run_* directly. Kept as
# required env (Invariant 2) so re-adding a worker is an env change, not a code
# change. memory:// placeholders are never connected.
CELERY_BROKER_URL=memory://
CELERY_RESULT_BACKEND=cache+memory://

# === Frontend build arg (baked into the standalone server.js at BUILD time) ===
# Points the Next /api/* rewrite at the backend over the compose network.
# Changing it requires `docker compose build frontend`, not just a restart.
BACKEND_URL=http://backend:8000
# Optional: cap the Next production-build heap on this memory-tight box (the build
# runs unbounded and spikes to 1.5-4 GB). Bounds it so it can't OOM the co-tenant
# app on this box. Plumbed through the frontend build arg; leave unset elsewhere.
# NODE_OPTIONS=--max-old-space-size=2048

# === Optional knobs (defaults are safe at launch; uncomment to override) ===
# DJANGO_SESSION_COOKIE_SAMESITE=Lax
# DJANGO_CSRF_COOKIE_SAMESITE=Lax
# Leave NUM_PROXIES=0 until a live XFF spoof test (chain: Caddy -> Next -> Django).
# DJANGO_NUM_PROXIES=0
# Ramp HSTS only after HTTPS is proven on the final host (Invariant 6).
# DJANGO_SECURE_HSTS_SECONDS=0
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# DJANGO_SECURE_HSTS_PRELOAD=False
