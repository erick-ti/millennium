# Millennium deploy (pull-based CD) config — copy to infra/hetzner/deploy.env
# (chmod 600), read by millennium-deploy.service as an EnvironmentFile. deploy.env
# is gitignored. Every value is OPTIONAL (the deployer works with none set); the
# Healthchecks URL is the one you'll usually want, so a failed/stopped deploy alerts.

# Healthchecks.io dead-man's-switch URL — its OWN check, NOT the backup's. The
# poller pings <URL> every tick (so a STOPPED poller alerts too), <URL>/start before
# a deploy, and <URL>/fail (with step/SHA/exit-code/log-tail) on any failure. The
# URL is a credential — keep deploy.env at chmod 600. Unset = no pings.
# DEPLOY_HEALTHCHECK_URL=https://hc-ping.com/your-millennium-deploy-uuid
#
# REQUIRED Healthchecks check config for this check: set the PERIOD to the timer
# cadence (~2 min) and the GRACE to comfortably exceed DEPLOY_RUN_TIMEOUT below
# (e.g. 25 min) — during a deploy the per-tick success pings PAUSE (one /start, then
# silence until success/fail), and flock-skipped ticks send nothing, so a grace
# tuned to the 2-min cadence would false-alarm "down" on every legitimate slow
# deploy. Grace must cover the whole deploy window, not the tick interval.

# Public host probed (through the edge, via --resolve to 127.0.0.1:443) to gate a
# deploy's success. Default: millennium.erickti.com.
# DEPLOY_PUBLIC_HOST=millennium.erickti.com

# Per-step timeouts in seconds (defaults shown). DEPLOY_RUN_TIMEOUT bounds the whole
# build+migrate+up+edge deploy; raise it if a cold build ever exceeds 20 min.
# DEPLOY_FETCH_TIMEOUT=60
# DEPLOY_RUN_TIMEOUT=1200
# DEPLOY_PROBE_TIMEOUT=15
