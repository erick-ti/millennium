{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "watchPatterns": ["backend/**", "infra/railway/cron-run-alerts.railway.json"]
  },
  "deploy": {
    "startCommand": "python manage.py run_alerts",
    "cronSchedule": "0 5 * * *",
    "restartPolicyType": "NEVER"
  }
}
