{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "watchPatterns": ["backend/**", "infra/railway/backend.railway.json"]
  },
  "deploy": {
    "preDeployCommand": ["sh -c 'python manage.py migrate --noinput && python manage.py createcachetable'"],
    "healthcheckPath": "/api/health/",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "drainingSeconds": 150
  }
}
