{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "watchPatterns": ["backend/**", "infra/railway/cron-value-portfolios.railway.json"]
  },
  "deploy": {
    "startCommand": "python manage.py value_portfolios",
    "cronSchedule": "0 4 * * *",
    "restartPolicyType": "NEVER"
  }
}
