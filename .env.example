# Copy to .env for local dev (the Makefile / docker-compose pick it up).
# Do not commit .env.

# ===========================================
# Django
# ===========================================
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-secret-do-not-use-in-prod
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend origin(s) the Django CSRF middleware accepts for /api/* POSTs from
# the Next.js dev proxy. Comma-separated. Without this, Django 403s every
# POST/PUT/DELETE/PATCH because the proxy rewrites Host but the browser still
# sends Origin=http://localhost:3000.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000

# ===========================================
# Database  (host: "postgres" inside compose, "localhost" outside)
# ===========================================
DATABASE_URL=postgres://postgres:postgres@localhost:5432/millennium

# ===========================================
# Redis (cache + Celery broker/result)
# ===========================================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ===========================================
# Production (Railway) — REFERENCE ONLY
# ===========================================
# These are NOT loaded locally (prod.py never reads a .env — Invariant 3). They
# are set in the Railway dashboard per service; this block documents the names +
# value shapes. Full per-service matrix + provisioning order: docs/railway-deploy-runbook.md.
# ${{Postgres.*}} / ${{Redis.*}} are Railway reference-variable syntax (rename to
# the actual managed-service names if they differ from "Postgres"/"Redis").
#
# Backend web + all 4 cron services (the backend image, config.settings.prod):
#   DJANGO_SETTINGS_MODULE=config.settings.prod
#   DJANGO_SECRET_KEY=<generate a strong 50+ char random value — never commit a real one>
#   DJANGO_ALLOWED_HOSTS=backend.railway.internal,healthcheck.railway.app
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://<your-app>.up.railway.app   # exact frontend origin; set after the domain exists, then redeploy
#   DATABASE_URL=${{Postgres.DATABASE_URL}}                          # prefer the private *.railway.internal host (verify live)
#   REDIS_URL=${{Redis.REDIS_URL}}
#   CELERY_BROKER_URL=${{Redis.REDIS_URL}}                           # idle under the cron topology (no worker) but fail-closed-required (Invariant 2)
#   CELERY_RESULT_BACKEND=${{Redis.REDIS_URL}}
#   DJANGO_SECURE_SSL_REDIRECT=False                                 # private-only backend: TLS terminates at the frontend edge; the plain-HTTP healthcheck must not 301
#   PORT=8000                                                        # backend web ONLY — pin so the baked frontend BACKEND_URL stays valid; cron services exit (no PORT), frontend uses Railway's injected PORT
# Optional knobs (leave at the prod.py defaults at launch):
#   DJANGO_SESSION_COOKIE_SAMESITE=Lax  DJANGO_CSRF_COOKIE_SAMESITE=Lax
#   DJANGO_NUM_PROXIES=0                                             # raise only after the slice-8 empirical XFF spoof test
#   DJANGO_SECURE_HSTS_SECONDS=0  (+ _INCLUDE_SUBDOMAINS / _PRELOAD) # ramp only after HTTPS is proven on the final host (Invariant 6)
#
# Frontend service (Next standalone image) — BACKEND_URL is a BUILD ARG baked into
# server.js (NOT a runtime var; changing it needs a frontend rebuild):
#   BACKEND_URL=http://backend.railway.internal:8000
