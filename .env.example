# Copy to .env for local dev (the Makefile / docker-compose pick it up).
# Do not commit .env.

# ===========================================
# Django
# ===========================================
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-secret-do-not-use-in-prod
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend origin(s) the Django CSRF middleware accepts for /api/* POSTs from
# the Next.js dev proxy. Comma-separated. Without this, Django 403s every
# POST/PUT/DELETE/PATCH because the proxy rewrites Host but the browser still
# sends Origin=http://localhost:3000.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000

# ===========================================
# Database  (host: "postgres" inside compose, "localhost" outside)
# ===========================================
DATABASE_URL=postgres://postgres:postgres@localhost:5432/millennium

# ===========================================
# Redis (cache + Celery broker/result)
# ===========================================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
